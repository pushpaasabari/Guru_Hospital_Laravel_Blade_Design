{
  "name": "guru-hospital-desktop",
  "version": "1.0.0",
  "description": "Guru Hospital — Windows Desktop Application (Hybrid Offline & Live Server)",
  "main": "src/main.js",
  "type": "module",
  "private": true,
  "author": "Guru Hospital",
  "license": "PROPRIETARY",
  "scripts": {
    "prepare-runtime": "node scripts/prepare-runtime.mjs",
    "start": "electron .",
    "pack": "node scripts/prepare-runtime.mjs && electron-builder --dir",
    "dist": "node scripts/prepare-runtime.mjs && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.guruhospital.desktop",
    "productName": "Guru Hospital",
    "copyright": "Copyright © Guru Hospital",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/app",
        "to": "app"
      },
      {
        "from": "build/php",
        "to": "php"
      },
      {
        "from": "build/chromium",
        "to": "chromium"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Guru Hospital",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}
